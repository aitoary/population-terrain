{
  "name": "population-terrain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/browser_smoke.mjs",
    "data:acquire": "python3 scripts/acquire_data.py",
    "data:prepare": ".venv/bin/python scripts/prepare_population.py",
        "data:verify": ".venv/bin/python scripts/verify_data.py",
    "test:python": ".venv/bin/python -m unittest discover -s scripts -p 'test_*.py'"
  },
  "dependencies": {
    "cesium": "1.145.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "5.0.0",
    "wrangler": "4.131.0"
  }
}
